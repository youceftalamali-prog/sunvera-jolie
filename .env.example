# Primary Master AI provider (text chat, vision input, and store-edit planning)
LLMTECH_API_KEY=
XKIRO_API_KEY=
MASTER_AI_MODEL=llmtech:nvidia/Qwen3.8-27B-NVFP4
AI_TEXT_MODEL=llmtech:nvidia/Qwen3.8-27B-NVFP4
AI_VISION_MODEL=llmtech:nvidia/Qwen3.8-27B-NVFP4

# Image/video generation remains disabled until a compatible media-generation API is configured.
AI_IMAGE_MODEL=disabled
AI_VIDEO_MODEL=disabled

# New-order email notifications (configure as Cloudflare Worker secrets/vars in production)
RESEND_API_KEY=
ORDER_NOTIFICATION_EMAIL=youceftalamali@gmail.com
# Verified sender address/domain in Resend, e.g. SunVera Jolie <orders@your-verified-domain>
ORDER_NOTIFICATION_FROM=
