{
  "name": "nextjs-postgresql-template",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:check": "node pg-start.mjs",
    "db:push": "drizzle-kit push --config=drizzle.config.ts",
    "test:p1:variant": "node scripts/test-p1-variant.mjs",
    "test:p1:location": "node scripts/test-p1-location.mjs",
    "test:p1:sku": "node scripts/test-p1-sku.mjs",
    "test:p1:atomicity": "node scripts/test-p1-atomicity.mjs",
    "test:p1:storage": "node scripts/test-p1-storage.mjs",
    "test:p1:rate-limit": "node scripts/test-p1-rate-limit.mjs",
    "test:p1:cms": "node scripts/test-p1-cms.mjs",
    "test:p2:image-association": "node scripts/test-p2-image-association.mjs",
    "test:p2:product-filtering": "node scripts/test-p2-product-filtering.mjs",
    "test:p2:media-pagination": "node scripts/test-p2-media-pagination.mjs",
    "test:p2:database-checks": "node scripts/test-p2-database-checks.mjs",
    "test:p2:database-indexes": "node scripts/test-p2-database-indexes.mjs",
    "test:p2:settings-validation": "node scripts/test-p2-settings-validation.mjs",
    "test:p2:order-status": "node scripts/test-p2-order-status-transitions.mjs",
    "test:p2:error-hardening": "node scripts/test-p2-error-hardening.mjs",
    "test:p2:media-deletion": "node scripts/test-p2-media-deletion.mjs",
    "test:p2:storage-cleanup": "node scripts/test-p2-storage-cleanup.mjs",
    "storage:orphans": "node scripts/cleanup-orphan-uploads.mjs",
    "storage:orphans:clean": "node scripts/cleanup-orphan-uploads.mjs --delete",
    "test:p2:master-ai-normalization": "node scripts/test-p2-master-ai-normalization.mjs",
    "test:p2:master-ai-contract": "node scripts/test-p2-master-ai-contract.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.7",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "image-size": "2.0.2",
    "isomorphic-dompurify": "^4.3.0",
    "next": "16.3.8",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "wrangler": "4.148.0"
  },
  "overrides": {
    "isomorphic-dompurify": {
      "jsdom": "25.0.1"
    }
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.4": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "sharp@0.35.4": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true,
    "workerd@1.20261006.1": true
  }
}
